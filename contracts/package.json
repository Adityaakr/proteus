{
  "name": "@proteus/contracts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "arc-forge build",
    "test": "arc-forge test -vv",
    "typecheck": "echo skip",
    "deploy:testnet": "arc-forge script script/Deploy.s.sol --rpc-url ${ARC_TESTNET_RPC_URL:-https://rpc.testnet.arc.io} --private-key $DEPLOYER_PRIVATE_KEY --broadcast",
    "deploy:mainnet": "arc-forge script script/Deploy.s.sol --rpc-url ${ARC_MAINNET_RPC_URL:-https://rpc.mainnet.arc.io} --private-key $DEPLOYER_PRIVATE_KEY --broadcast",
    "verify:mainnet": "arc-forge verify-contract $ESCROW_ADDRESS src/DealEscrow.sol:DealEscrow --chain-id 5042 --verifier blockscout --verifier-url https://explorer.arc.io/api/",
    "verify:testnet": "arc-forge verify-contract $ESCROW_ADDRESS src/DealEscrow.sol:DealEscrow --chain-id 5042002 --verifier blockscout --verifier-url https://explorer.testnet.arc.io/api/",
    "abi": "node scripts/export-abi.cjs",
    "deploy:policy-registry:testnet": "arc-forge script script/DeployPolicyRegistry.s.sol --rpc-url ${ARC_TESTNET_RPC_URL:-https://rpc.testnet.arc.io} --private-key $DEPLOYER_PRIVATE_KEY --broadcast",
    "deploy:policy-registry:mainnet": "arc-forge script script/DeployPolicyRegistry.s.sol --rpc-url ${ARC_MAINNET_RPC_URL:-https://rpc.mainnet.arc.io} --private-key $DEPLOYER_PRIVATE_KEY --broadcast",
    "verify:policy-registry:testnet": "arc-forge verify-contract 0xa3f759525b5657182A8D7deCB0B40d4C66aC4A5A src/ProteusPolicyRegistry.sol:ProteusPolicyRegistry --chain-id 5042002 --constructor-args 0x0000000000000000000000008004a818bfb912233c491871b3d84c89a494bd9e --verifier blockscout --verifier-url https://explorer.testnet.arc.io/api/",
    "verify:policy-registry:mainnet": "arc-forge verify-contract 0x376dFc4f1D356E78cc46983478A0F2e12CA7C84B src/ProteusPolicyRegistry.sol:ProteusPolicyRegistry --chain-id 5042 --constructor-args 0x0000000000000000000000008004a169fb4a3325136eb29fa0ceb6d2e539a432 --verifier sourcify"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.6.1"
  }
}
