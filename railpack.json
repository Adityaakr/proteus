{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "build": {
      "commands": [
        "pnpm --filter @proteus/domain typecheck",
        "pnpm --filter @proteus/server typecheck",
        "pnpm --filter proteus-site build"
      ]
    }
  },
  "deploy": {
    "startCommand": "pnpm --filter @proteus/server start:prod"
  }
}
