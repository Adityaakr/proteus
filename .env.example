# Copy to server/.env. Never commit real values.

PORT=8787
WEB_ORIGIN=http://localhost:5174
DATABASE_URL=postgres://localhost:5432/proteus
SESSION_SECRET=change-me-to-a-long-random-string

# Arc testnet (https://docs.arc.io/arc/references/connect-to-arc.md)
ARC_RPC_URL=https://rpc.testnet.arc.io
CHAIN_ID=5042002
USDC_ADDRESS=0x3600000000000000000000000000000000000000
# Set after `pnpm --filter @proteus/contracts deploy:testnet` (see DEPLOYMENT.md)
ESCROW_ADDRESS=

# Keys (generate with `pnpm --filter @proteus/server keys:gen`; fund deployer + relayer at https://faucet.circle.com)
DEPLOYER_PRIVATE_KEY=
SELLER_SIGNER_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=
# Real seller owner wallet (SIWE console login + payee). Optional for the sandbox seller.
OWNER_ADDRESS=

# Circle developer-controlled wallet relayer (preferred when set). ARC-TESTNET wallet.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_ID=
CIRCLE_WALLET_ADDRESS=

# Model provider for the negotiation agent (optional; rule-based adapter runs without it)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Deal term grace window in seconds (refunds of unused balance open after end + grace, or when the seller closes the term)
DEAL_GRACE_SECONDS=259200
RECONCILE_INTERVAL_MS=10000
