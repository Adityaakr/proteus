# Copy to server/.env. Never commit real values.

PORT=8787
WEB_ORIGIN=http://localhost:5174
DATABASE_URL=postgres://localhost:5432/proteus
SESSION_SECRET=change-me-to-a-long-random-string

# Arc testnet (https://docs.arc.io/arc/references/connect-to-arc.md)
ARC_RPC_URL=https://rpc.testnet.arc.io
CHAIN_ID=5042002
USDC_ADDRESS=0x3600000000000000000000000000000000000000
# Set after `pnpm --filter @proteus/contracts deploy:testnet` (see DEPLOYMENT.md)
ESCROW_ADDRESS=

# Keys (generate with `pnpm --filter @proteus/server keys:gen`; fund deployer + relayer at https://faucet.circle.com)
DEPLOYER_PRIVATE_KEY=
SELLER_SIGNER_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=
# Real seller owner wallet (SIWE console login + payee). Optional for the sandbox seller.
OWNER_ADDRESS=

# Circle developer-controlled wallet relayer (preferred when set). ARC-TESTNET wallet.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_ID=
CIRCLE_WALLET_ADDRESS=

# Model provider for the negotiation agent and the service agents. OpenRouter is preferred when set,
# then Anthropic; with neither, the deterministic rule-based adapter runs and Proteus-run services refuse unbilled.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Privy login (JWT verified against the app's JWKS). PRIVY_DEV_BYPASS=1 honours an x-dev-user header; never in production.
PRIVY_APP_ID=cmvb0p1b901l50fl20lp1eths
PRIVY_JWKS_URL=
PRIVY_DEV_BYPASS=

# Encrypts per-org signer keys and seller endpoint secrets at rest (AES-256-GCM). Falls back to SESSION_SECRET in dev.
KEY_ENCRYPTION_SECRET=

# Invite gate. INVITE_GATE=1 requires a redeemed invite code per account (default on in production, off otherwise).
# INVITE_PEPPER keys the HMAC of stored codes (falls back to SESSION_SECRET; changing it invalidates every code).
# ADMIN_TOKEN (32+ chars) enables POST/GET /api/admin/invites to mint, list and revoke codes. Unset disables them.
INVITE_GATE=
INVITE_PEPPER=
ADMIN_TOKEN=

# x402 pay per call through Circle's facilitator
X402_FACILITATOR_URL=https://api.circle.com/v1/facilitator/x402
X402_NETWORK=eip155:5042002

# Deal term grace window in seconds (refunds of unused balance open after end + grace, or when the seller closes the term)
DEAL_GRACE_SECONDS=259200
RECONCILE_INTERVAL_MS=10000
